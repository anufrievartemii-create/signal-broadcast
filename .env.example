# --- Приложение ---
HOST=127.0.0.1
PORT=8000
# Токен доступа к панели. Пустое значение = авторизация выключена (только для локальной разработки!)
ADMIN_TOKEN=
LOG_LEVEL=INFO

# --- Signal ---
# rest_api = контейнер bbernhard/signal-cli-rest-api (по умолчанию)
# jsonrpc  = нативный signal-cli daemon --http (нужен JRE 21+)
# fake     = тестовый бэкенд, ничего не отправляет
SIGNAL_BACKEND=rest_api
SIGNAL_API_URL=http://127.0.0.1:8080
SIGNAL_API_TIMEOUT=60
SIGNAL_DEVICE_NAME=signal-broadcast

# --- База ---
# DATABASE_URL=sqlite+aiosqlite:///C:/Users/anufr/signal-broadcast/data/app.db

# --- Защита от бана: лимиты рассылки ---
DELAY_MIN=3
DELAY_MAX=8
MAX_RETRIES=3
HOURLY_CAP=120
DAILY_CAP=500

# --- Входящие / отписки ---
STOP_WORDS=стоп,stop,отписка,unsubscribe
AUTO_OPT_OUT=true
